# Sarvam AI API Configuration (Backend Only — Never Expose to Frontend)
SARVAM_API_KEY=your_key_here

# Persistent Archive Storage Path (Mount a persistent disk in production, e.g., /var/data/archive.json)
# On first boot, if this file does not exist yet, it is automatically seeded from backend/data/archive.json
ARCHIVE_DATA_PATH=

# Allowed CORS Origins (Comma-separated frontend URLs in production, or * for open access)
ALLOWED_ORIGINS=*

PORT=8000
HOST=0.0.0.0
